[Unit]
Description=PESS GSM (4G module) AT service
# 不写死串口设备：EM05 上是 ttyUSB2、L610 上是 ttyUSB0，由 gsmd 自己按
# /dev/serial/by-id/*-if02-port0 找 AT 口，换机器不用改这张 unit。
After=network.target
Wants=network.target

[Service]
Type=simple
# 等 AT 口出现（最多 300s）：模块 USB 枚举晚于 systemd 时不要进入无谓的重启循环。
ExecStartPre=/bin/sh -c 'i=0; while ! ls /dev/serial/by-id/*-if02-port0 >/dev/null 2>&1 && ! ls /dev/ttyUSB0 >/dev/null 2>&1; do i=$((i+1)); if [ $i -ge 60 ]; then echo "no 4G AT port found" >&2; exit 1; fi; sleep 5; done'
ExecStart=/usr/sbin/gsmd -config /etc/gsm/gsm.yaml
# 常驻服务：串口掉线、模块复位后自己重连；只有配置错误(退出码 2)不重启。
Restart=always
RestartSec=3s
RestartPreventExitStatus=2
User=gsmd
Group=dialout
SupplementaryGroups=dialout
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# 版本文件由本服务自己维护（取代会抢 AT 口的 4G-info-get.service），需要这一个可写目录。
ReadWritePaths=/etc/mmdc
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
